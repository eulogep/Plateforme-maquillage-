# Copy this file to .env and fill in real values. Never commit .env — it's
# already gitignored (.env / .env.local / .env.*.local).

# --- Client-side (safe to expose in the built bundle — Vite requires the
#     VITE_ prefix to expose a var to client code at all) ---

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public API key. This key is meant to be public — it only
# grants what Row Level Security policies allow (see supabase/migrations/).
VITE_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix these with VITE_, and never reference them
#     from client code. Left blank on purpose. ---

# Supabase service-role key. Bypasses Row Level Security entirely. Used only
# by supabase/functions/create-booking (the Edge Function that writes
# appointments), which reads it from Deno.env — not from this file. Set it
# for local `supabase functions serve` with:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<key>
# In deployed Edge Functions, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# auto-provided by the platform and don't need to be set manually.
SUPABASE_SERVICE_ROLE_KEY=

# Placeholder for the future Stripe integration (not implemented yet).

# Stripe secret key — server-side only, used once payment is wired up.
STRIPE_SECRET_KEY=

# Stripe publishable key is client-safe when that milestone arrives, and
# would use the VITE_ prefix like the Supabase vars above:
# VITE_STRIPE_PUBLISHABLE_KEY=
