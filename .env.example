# Copy this file to .env and fill in real values. Never commit .env — it's
# already gitignored (.env / .env.local / .env.*.local).

# --- Client-side (safe to expose in the built bundle — Vite requires the
#     VITE_ prefix to expose a var to client code at all) ---

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public API key. This key is meant to be public — it only
# grants what Row Level Security policies allow (see supabase/migrations/).
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key — client-safe. MUST be a pk_test_... key for this
# milestone; nothing in this app should ever use a live pk_live_... key.
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Server-only — NEVER prefix these with VITE_, and never reference them
#     from client code. Left blank on purpose. ---

# Supabase service-role key. Bypasses Row Level Security entirely. Used only
# by supabase/functions/create-booking (the Edge Function that writes
# appointments), which reads it from Deno.env — not from this file. Set it
# for local `supabase functions serve` with:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<key>
# In deployed Edge Functions, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# auto-provided by the platform and don't need to be set manually.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated production origin(s) allowed to call the create-booking
# Edge Function (CORS). Local dev origins (localhost:5173/4173) are always
# allowed regardless — this is only for the real deployed site's domain.
# There is no '*' fallback in the function; an origin not on this list is
# rejected. Set with:
#   supabase secrets set ALLOWED_ORIGINS=https://emmanuellesingani.com,https://www.emmanuellesingani.com
ALLOWED_ORIGINS=

# --- Stripe — TEST MODE ONLY for this milestone. Both keys MUST be the
#     sk_test_.../whsec_... test-mode values; never a live key. Used by
#     supabase/functions/create-payment-intent and stripe-webhook, read
#     from Deno.env, never from this file directly in production. ---

# Stripe secret key (test mode: sk_test_...). Server-side only.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...), from the webhook endpoint's
# settings in the Stripe Dashboard (test mode) or `stripe listen` locally.
# Server-side only — used to verify that a webhook request genuinely came
# from Stripe before trusting any payment event.
STRIPE_WEBHOOK_SECRET=

# Technical/test configuration, NOT an Emmanuelle business policy: how long
# a booking hold lasts before an unpaid appointment is released back to
# availability. Defaults to 15 minutes if unset (see
# supabase/functions/_shared/holdLifecycle.js). Set with:
#   supabase secrets set HOLD_DURATION_MINUTES=15
HOLD_DURATION_MINUTES=

# --- Email (Resend) — server-side only. Used by create-payment-intent and
#     stripe-webhook via supabase/functions/_shared/notifications/. If
#     unset, emails are recorded as 'failed' (retryable) rather than
#     blocking any booking/payment operation. ---

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address/domain in Resend. Defaults to Resend's own
# onboarding@resend.dev sandbox sender if unset (fine for testing; only
# delivers to the account owner's own verified email in that sandbox mode).
RESEND_FROM_EMAIL=

# --- Google Calendar sync (optional) — server-side only. If any of these
#     four are missing, calendar sync is skipped entirely (logged, never
#     blocking). See supabase/functions/_shared/googleCalendar/. ---

# OAuth 2.0 client credentials for a Google Cloud project with the Calendar
# API enabled (Google Cloud Console -> APIs & Services -> Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A refresh token obtained ONCE via the standard OAuth consent flow for the
# business's own Google account (not a customer-facing flow) — grants
# offline access to https://www.googleapis.com/auth/calendar.events.
GOOGLE_REFRESH_TOKEN=

# The calendar to sync confirmed appointments into — "primary" for the
# account's main calendar, or a specific calendar's id.
GOOGLE_CALENDAR_ID=
